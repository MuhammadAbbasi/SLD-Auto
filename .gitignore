# ==============================================================================
# .gitignore - A176LAB SLD Generator
# ==============================================================================

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyw~
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
*.env
# Set SLD_TEMPLATE_PATH here instead of hardcoding in source

# ── Old / archived code versions ─────────────────────────────────────────────
code/old/

# ── Build artifacts & distribution ──────────────────────────────────────────
code/build/
code/dist/
build/
dist/
*.spec
*.exe
*.app

# ── Generated / output DXF files ─────────────────────────────────────────────
*_Generated.dxf
*_generated.dxf
*_SLD_*.dxf

# ── Large binary files (DXF / DWG / Excel) ───────────────────────────────────
*.dxf
*.dwg
*.xlsx
*.xls

# ── Template DXF (mount via Docker volume, never bake into image/repo) ───────
webapp/template/*.dxf

# ── GUI / app runtime data ───────────────────────────────────────────────────
code/history.json
code/history_v2.json
code/smart_history.json
code/template_data.json

# ── Media / screenshots / compiled assets ────────────────────────────────────
code/screenshots/
media/
*.ico
code/logoA176LAB.jpg
code/logoA176LAB.ico

# ── Client project folders (contain confidential data and large files) ────────
YANEL/
Example/
Bellomo/
/Template/
2025.017*/
"PV WYMONDLY"/
PV*/

# ── External / sub-projects (managed independently) ─────────────────────────
Easy-MCP-AutoCad/

# ── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace
*.sublime-project
*.sublime-workspace
*.suo
*.user
.vs/

# ── Windows ──────────────────────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Logs / temp ──────────────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.swp
